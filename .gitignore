# ============================================
#  依赖
# ============================================
node_modules/
package-lock.json
yarn.lock

# ============================================
#  引擎源码（由脚本自动拉取，不入库）
#  见 scripts/fetch-engine.ps1
# ============================================
engine-src/

# ============================================
#  NNUE 权重（11.8MB 二进制，由脚本下载）
#  见 scripts/fetch-engine.ps1
# ============================================
*.nnue

# ============================================
#  编译产物
# ============================================
build/
*.o
*.a
*.so
*.log

# ============================================
#  uniapp / HBuilderX
# ============================================
app/unpackage/
.hbuilderx/

# ============================================
#  已组装的原生插件目录（约 28MB，属于构建产物）
#  内含 .so / .nnue 二进制，以及与 native/ 下重复的源码副本。
#  源码的唯一权威位置是 native/android/ 与 native/ios/，
#  不要把插件目录里的副本入库，否则两处修改必然走偏。
#  获取方式：从 CI Release 下载插件包解压，见 docs/发布流程.md
# ============================================
app/nativeplugins/

# ============================================
#  iOS / Xcode
# ============================================
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/
DerivedData/
*.framework/

# ============================================
#  签名证书与私钥（绝对不能入库！）
#  .p12 是 iOS 签名私钥，泄露后他人可冒充您的开发者身份签名 App；
#  .keystore/.jks 同理，丢了就无法给已上架应用发更新。
#  请自行备份到安全位置（密码管理器 / 加密网盘）。
# ============================================
iOS/
ios-certs/
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.keystore
*.jks
*.pem
*.key

# ============================================
#  临时文件
# ============================================
test_out.log
sim_out.log
.DS_Store
Thumbs.db

# ============================================
#  误创建的异常文件名
#  曾因 node -e 命令被 shell 转义吞掉参数，
#  在仓库根目录生成过名为 '+e.message)}}) 的空文件
#  并被 git add -A 提交入库。此处兜底拦截。
# ============================================
'*
*)}})*
