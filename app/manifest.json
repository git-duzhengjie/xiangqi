          "__plugin_info__": {
            "name": "XiangqiEngine",
            "description": "Pikafish 象棋引擎原生插件",
            "platforms": "Android,iOS",
            "android_package_name": "com.xiangqi.master",
            "ios_bundle_id": "com.xiangqi.master",
            "isCloud": false,
            "bought": 1,
            "pid": "",
            "parameters": {}
          }
        }
      }
    }
  },
  "quickapp": {},
  "vueVersion": "2"
